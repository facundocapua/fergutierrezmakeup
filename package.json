{
  "name": "fergutierrezmakeup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:baseline": "PARITY_BASELINE=1 playwright test --update-snapshots",
    "parity": "playwright test",
    "images:optimize": "node scripts/optimize-images.mjs",
    "prepare": "simple-git-hooks",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix --no-warn-ignored",
    "*": "prettier --write --ignore-unknown"
  }
}
